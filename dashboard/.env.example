# Copy to .env.local for local development. Never commit real values.

# Your private code that opens the whole site. Vercel: Settings > Environment Variables (Secret).
# Without it, production is locked for everyone; local dev is open.
SITE_ACCESS_CODE=

# Password for /admin. Without it, nobody can log in to admin in production (local dev: "dev").
ADMIN_PASSWORD=

# Added automatically when you connect Upstash Redis in Vercel (Storage / Marketplace).
# Without them, production stays closed to the audience and admin switches cannot be saved.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Claude API key for Live AI (Vercel Secret). Used only on the server.
ANTHROPIC_API_KEY=
# Optional: model for Live AI. Default claude-opus-5-5. Cheaper: claude-haiku-5-5.
CLAUDE_MODEL=
